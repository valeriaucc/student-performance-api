# Local Development Configuration Template
# Copy this file to application-local.properties and fill in your actual values
# The application-local.properties file is git-ignored to keep your secrets safe

# Database Configuration - Get from Supabase Dashboard > Project Settings > Database
# Use Session Pooler for IPv4 networks (port 5432)
# Note: URL-encode special characters in password (spaces = %20, etc.)
spring.datasource.url=jdbc:postgresql://aws-0-us-east-0.pooler.supabase.com:5432/postgres?password=YOUR_PASSWORD_URL_ENCODED
spring.datasource.username=postgres.YOUR_PROJECT_REF
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool Configuration for Supabase
# Optimized for Session Pooler (short-lived connections)
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=600000
spring.datasource.hikari.connection-test-query=SELECT 1
spring.datasource.hikari.pool-name=HikariPool-Supabase

# Hibernate Configuration
# Using 'none' to avoid schema migration during startup (use manual migrations)
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Server Configuration
server.port=8080

# Supabase Configuration - Get from Supabase Dashboard > Project Settings > API
supabase.jwt.secret=YOUR_JWT_SECRET_HERE
supabase.url=https://YOUR_PROJECT_REF.supabase.co
supabase.anon.key=YOUR_ANON_KEY_HERE
supabase.service.role.key=YOUR_SERVICE_ROLE_KEY_HERE

# CORS Configuration - Add your frontend URLs
security.cors.allowed-origins=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Logging - Enable security logging for debugging
logging.level.org.springframework.security=DEBUG

