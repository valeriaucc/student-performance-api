# Local Development Configuration Template
# Copy this file to application-local.properties and fill in your actual values
# The application-local.properties file is git-ignored to keep your secrets safe
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp application-local.properties.template application-local.properties
# 2. Fill in your actual Supabase credentials (see comments below)
# 3. Start the app: ./mvnw spring-boot:run -Dspring.profiles.active=local
#
# IMPORTANT: This file inherits ALL configuration from application.properties
# Only override values that differ for your local environment (DB connection, secrets, etc.)

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Get from Supabase Dashboard > Project Settings > Database
# Use Session Pooler for IPv4 networks (port 5432)
# Note: URL-encode special characters in password (spaces = %20, etc.)
spring.datasource.url=jdbc:postgresql://aws-0-us-east-0.pooler.supabase.com:5432/postgres?password=YOUR_PASSWORD_URL_ENCODED
spring.datasource.username=postgres.YOUR_PROJECT_REF
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool - Optimized for Supabase Session Pooler
# These override the defaults from application.properties for local development
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=600000
spring.datasource.hikari.connection-test-query=SELECT 1
spring.datasource.hikari.pool-name=HikariPool-Supabase

# ============================================================================
# HIBERNATE CONFIGURATION
# ============================================================================
# Using 'none' to avoid schema migration during startup (use manual migrations)
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
server.port=8080

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get from Supabase Dashboard > Project Settings > API
supabase.jwt.secret=YOUR_JWT_SECRET_HERE
supabase.url=https://YOUR_PROJECT_REF.supabase.co
supabase.anon.key=YOUR_ANON_KEY_HERE
supabase.service.role.key=YOUR_SERVICE_ROLE_KEY_HERE

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Get from OpenAI Dashboard > API Keys: https://platform.openai.com/api-keys
openai.api.key=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
openai.api.timeout=30000
