# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Add your frontend URLs (comma-separated)
security.cors.allowed-origins=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Enable security logging for debugging authentication issues
logging.level.org.springframework.security=DEBUG

# ============================================================================
# PHASE 3 - MONITORING & OBSERVABILITY (Inherited from application.properties)
# ============================================================================
# The following are already configured in application.properties and available:
# - Actuator endpoints: /actuator/health, /actuator/metrics, /actuator/prometheus
# - Custom health checks: Database, Supabase Auth, Application status
# - Prometheus metrics export
# - Distributed tracing (Zipkin)
# - Application info endpoint
#
# You can override any of these if needed for local development, but typically
# you should just inherit the defaults from application.properties
#
# Example overrides (uncomment if needed):
# management.endpoints.web.exposure.include=health,info,metrics,prometheus,env,loggers,threaddump
# management.tracing.sampling.probability=1.0  # 100% sampling for local debugging

